<?xml version="1.0" encoding="utf-8"?>
<!-- 滑杆滑块：金色圆点 + 外发光 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#33D4AF37" />
            <size
                android:width="24dp"
                android:height="24dp" />
        </shape>
    </item>
    <item
        android:left="6dp"
        android:right="6dp"
        android:top="6dp"
        android:bottom="6dp">
        <shape android:shape="oval">
            <solid android:color="#F5E7A3" />
            <size
                android:width="12dp"
                android:height="12dp" />
            <stroke
                android:width="1dp"
                android:color="#8A6D1F" />
        </shape>
    </item>
</layer-list>