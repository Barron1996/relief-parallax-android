<?xml version="1.0" encoding="utf-8"?>
<!--
  控制面板（黑金版）
  结构：根为纵向 LinearLayout，fitsSystemWindows=false，
        顶部品牌条自行用 padding 让开状态栏 → 视觉上底色延伸到状态栏之后，
        与 Theme 的透明状态栏配合，形成整块无缝效果。
  id 与旧版保持一致，避免 MainActivity 改动成本。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_page"
    android:fitsSystemWindows="false">

    <!-- ==================== 顶部品牌区 ==================== -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:background="@drawable/bg_page">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_main"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tv_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_tagline"
            android:textColor="@color/gold"
            android:textSize="9sp"
            android:letterSpacing="0.32"
            android:paddingTop="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="10dp">

            <TextView
                android:id="@+id/tv_state"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/state_ready"
                android:textColor="@color/gold_light"
                android:textSize="11sp"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_fps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="— FPS"
                android:textColor="@color/text_dim"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:paddingStart="10dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/divider_gold" />
    </LinearLayout>

    <!-- ==================== GL 预览 ==================== -->
    <FrameLayout
        android:id="@+id/preview_box"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card"
        android:padding="1dp">

        <android.opengl.GLSurfaceView
            android:id="@+id/gl_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 右上角：按住看原图的提示角标 -->
        <TextView
            android:id="@+id/tv_preview_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/bg_badge"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:text="PREVIEW"
            android:textColor="@color/gold"
            android:textSize="8sp"
            android:letterSpacing="0.24" />
    </FrameLayout>

    <!-- ==================== 底部控制面板（可滚动） ==================== -->
    <ScrollView
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="10dp"
        android:fillViewport="false"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ========== 卡片：效果参数 ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/group_effect"
                    style="@style/CardTitle" />

                <!-- 浮雕强度 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/lbl_relief"
                        style="@style/Lbl" />
                    <TextView
                        android:id="@+id/tv_v_relief"
                        android:text="100"
                        style="@style/LblVal" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/sb_relief"
                    style="@style/Sb" />

                <!-- 视差强度 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/lbl_parallax"
                        style="@style/Lbl" />
                    <TextView
                        android:id="@+id/tv_v_parallax"
                        android:text="100"
                        style="@style/LblVal" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/sb_parallax"
                    style="@style/Sb" />

                <!-- 假深度 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/lbl_depth"
                        style="@style/Lbl" />
                    <TextView
                        android:id="@+id/tv_v_depth"
                        android:text="50"
                        style="@style/LblVal" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/sb_depth"
                    style="@style/Sb" />

                <!-- 光晕抑制 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/lbl_halo"
                        style="@style/Lbl" />
                    <TextView
                        android:id="@+id/tv_v_halo"
                        android:text="70"
                        style="@style/LblVal" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/sb_halo"
                    style="@style/Sb" />

                <!-- 法线锐度 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/lbl_sharp"
                        style="@style/Lbl" />
                    <TextView
                        android:id="@+id/tv_v_sharp"
                        android:text="140"
                        style="@style/LblVal" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/sb_sharp"
                    style="@style/Sb" />

                <!-- 光源角度 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/lbl_light"
                        style="@style/Lbl" />
                    <TextView
                        android:id="@+id/tv_v_light"
                        android:text="315°"
                        style="@style/LblVal" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/sb_light"
                    style="@style/Sb" />
            </LinearLayout>

            <!-- ========== 卡片：运行开关 ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/group_perf"
                    style="@style/CardTitle" />

                <!-- 主开关：悬浮窗 / 一键关闭 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <Button
                        android:id="@+id/btn_overlay"
                        android:text="@string/btn_overlay"
                        style="@style/BtnGold" />

                    <Button
                        android:id="@+id/btn_kill"
                        android:text="@string/btn_kill"
                        style="@style/BtnGhost"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <!-- 陀螺仪 / 自动漂移 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/btn_gyro"
                        android:text="@string/btn_gyro"
                        style="@style/BtnGhost" />

                    <Button
                        android:id="@+id/btn_drift"
                        android:text="@string/btn_drift"
                        style="@style/BtnGhost"
                        android:layout_marginStart="10dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ========== 卡片：素材与其他 ========== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/group_misc"
                    style="@style/CardTitle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <Button
                        android:id="@+id/btn_pick"
                        android:text="@string/btn_pick"
                        style="@style/BtnGhost" />

                    <Button
                        android:id="@+id/btn_reset"
                        android:text="@string/btn_reset"
                        style="@style/BtnGhost"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/btn_split"
                        android:text="@string/btn_split"
                        style="@style/BtnGhost" />

                    <Button
                        android:id="@+id/btn_panel"
                        android:text="@string/btn_panel"
                        style="@style/BtnGhost"
                        android:layout_marginStart="10dp" />
                </LinearLayout>
                <Button
                    android:id="@+id/btn_guide"
                    android:text="@string/guide_title"
                    style="@style/BtnGhost"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>